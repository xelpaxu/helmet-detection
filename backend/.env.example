# Environment variables are read from the process; this file is a reference, not auto-loaded.
MODEL_PATH=model/best.pt
MODEL_DEVICE=cpu
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Relative paths are resolved from the server working directory.
MONITOR_DATA_DIR=data
# 0 disables automatic cleanup. Positive values remove expired sessions at startup.
RETENTION_DAYS=7
